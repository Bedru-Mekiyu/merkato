# ============================================================================
# MERKATO - Environment Variables
# Copy this file to .env.local and fill in your actual values.
# ============================================================================

# ── Supabase (required) ──────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── App URL (required — used to build links in emails/invites) ───────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Anthropic AI Assistant (optional — enables /ai-assistant) ────────────────
# Get your key from: https://console.anthropic.com/settings/api-keys
# Without it, the AI page shows a clear message; everything else works.
ANTHROPIC_API_KEY=sk-ant-...

# ── Resend transactional email (optional) ────────────────────────────────────
# Powers invitations, ticket notifications, task-assigned and weekly digest.
# Get your key from: https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ── OAuth (optional — enables Google and GitHub login buttons) ────────────────
# Configure in Supabase → Authentication → Providers, then set flags here.
# Redirect URL to whitelist in both providers:
#   https://your-project.supabase.co/auth/v1/callback
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=true

# ── Weekly digest cron (optional — powers GET /api/cron/weekly-digest) ───────
# CRON_SECRET protects the endpoint; Vercel Cron sends it automatically as
# `Authorization: Bearer <CRON_SECRET>`. Schedule lives in vercel.json.
CRON_SECRET=
# Service-role key (Settings → API). REQUIRED for the digest because the job
# reads across all organizations. Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
